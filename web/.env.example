# =============================================================================
# SP-MIS web (React/Vite) — environment template
# Copy to .env (`cp .env.example .env`). Only VITE_-prefixed vars are exposed
# to the browser bundle, so never put secrets here.
# =============================================================================

# Base URL of the SP-MIS API (no trailing slash). The app calls `${VITE_API_BASE_URL}/health` etc.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Display name used in the UI.
VITE_APP_NAME="SP-MIS"

# Map tile source for the GIS coverage maps (FR-GIS-01).
#
# REQUIRED IN PRODUCTION. The code falls back to the public OpenStreetMap tile
# servers, which the production Content-Security-Policy (`img-src 'self' data:` in
# docker/nginx/prod.conf.template) correctly BLOCKS — so leaving this unset renders the
# maps blank rather than silently sending every officer's map viewport to a third party.
#
# Point it at a tile source served from your own origin. Using a third-party tile host
# instead is a DPO decision: it tells that host which LGAs/wards are being examined and
# when, and it requires deliberately extending the CSP's `img-src` to that host.
VITE_MAP_TILE_URL=
